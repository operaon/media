# Serviço
NODE_ENV=development
SERVICE_NAME=operaon_media
HOST=0.0.0.0
PORT=4790
TRUST_PROXY_HOPS=1

# Banco próprio do catálogo de metadados de mídia
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operaon_media
DB_USER=dbadmin
DB_PASSWORD=
DB_SSL=false
DATABASE_URL=

# Banco legado usado somente pelo backfill dry-run
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=velyon_api
LEGACY_DB_USER=dbadmin
LEGACY_DB_PASSWORD=
LEGACY_DATABASE_URL=

# Autenticação dual; substituir pelo ambiente de execução em produção
SERVICE_API_KEY=media-development-service-key
JWT_ALGORITHM=HS256
JWT_SECRET=media-development-jwt-secret-change-me
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-media
JWT_PUBLIC_KEY=

# Operação
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
REQUEST_TIMEOUT_MS=5000
MAX_QUERY_LIMIT=100
BACKFILL_WRITE_ENABLED=false
MEDIA_MIGRATION_WRITE_ENABLED=false
MEDIA_MIGRATION_DELETE_LEGACY_ENABLED=false

# Object storage S3-compatible / MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=operaon-media
LEGACY_MINIO_BUCKET=velyon-files
MINIO_PUBLIC_ENDPOINT=/minio
MINIO_REGION=us-east-1
PRESIGN_EXPIRY_SECONDS=900
MEDIA_MAX_FILE_SIZE_BYTES=10485760

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-media
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
# Em produção, o ingress deve exigir X-Service-Id, X-Key-Id e mTLS.
REQUIRE_SERVICE_IDENTITY_HEADERS=true
REQUIRE_MTLS=true
TRUSTED_MTLS_HEADER=x-ssl-client-verify
